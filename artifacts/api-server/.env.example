PORT=3000

# Email recipient for the six question answers.
ANSWERS_EMAIL_TO=your-email@gmail.com
ANSWERS_EXPECTED_COUNT=6

# SMTP settings. Gmail requires an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
